# App
APP_NAME=NewsPulse API
APP_VERSION=1.0.0
DEBUG=false
JWT_SECRET_KEY=replace_with_a_long_random_secret
CORS_ORIGINS=http://localhost,http://localhost:3000
CLICKHOUSE_QUERY_RETRIES=3
RETRY_BASE_DELAY_SECONDS=0.2
HEALTHCHECK_TIMEOUT_SECONDS=3
SSE_ALERT_CACHE_SECONDS=5

# PostgreSQL (Data Warehouse)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=newspulse
POSTGRES_USER=newspulse
POSTGRES_PASSWORD=your_secure_postgres_password
PG_PASSWORD=your_secure_postgres_password

# MongoDB (Raw Storage)
MONGO_BACKFILL_URI=mongodb://localhost:27017/
MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_DB=newspulse
MONGO_INITDB_ROOT_PASSWORD=your_secure_mongo_password

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_EXT_PORT=29092
KAFKA_DELIVERY_TIMEOUT_SECONDS=120
KAFKA_FAIL_ON_DATA_LOSS=true
KAFKA_DLQ_TOPIC=newspulse.dlq
CLICKHOUSE_INSERT_BATCH_SIZE=1000
CLICKHOUSE_SINK_PARTITIONS=4
CLICKHOUSE_WRITE_RETRIES=3

# API Settings
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Crawler throughput and freshness
CRAWL_CONCURRENT_REQUESTS=32
CRAWL_CONCURRENT_REQUESTS_PER_DOMAIN=4
CRAWL_CONCURRENT_ITEMS=100
CRAWL_RATE_LIMIT=0.5
DEFAULT_CRAWL_RATE_LIMIT_SECONDS=0.5
RSS_MAX_AGE_HOURS=6
PERSISTENT_DEDUP_ENABLED=true

# ClickHouse (host development; Docker Compose overrides the hostname)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=newspulse
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin123

# Spark NLP (bounded for CPU-only development hosts)
NLP_ENABLED=false
NLP_MAX_OFFSETS_PER_TRIGGER=20
NLP_PROCESSING_PARTITIONS=2
NLP_STREAMING_TRIGGER_INTERVAL=60 seconds
NLP_BACKFILL_WORKERS=2
NLP_BACKFILL_THREADS_PER_WORKER=2
NLP_BACKFILL_BATCH_SIZE=20
CLICKBAIT_ENABLED=false

# Spike Detection
SPIKE_THRESHOLD_MULTIPLIER=2.0
SPIKE_WINDOW_HOURS=6

# Airflow
AIRFLOW__WEBSERVER__WEB_SERVER_PORT=8081
AIRFLOW__WEBSERVER__SECRET_KEY=your_secure_secret_key
AIRFLOW_API_URL=http://airflow-webserver:8080/api/v1
AIRFLOW_API_USERNAME=admin
AIRFLOW_API_PASSWORD=replace_with_a_secure_airflow_password

# Telegram alert delivery
TELEGRAM_BOT_TOKEN=replace_with_a_botfather_token
TELEGRAM_CHAT_ID=replace_with_a_chat_or_channel_id
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_MAX_ATTEMPTS=3
TELEGRAM_RETRY_BASE_SECONDS=1
TELEGRAM_ALERT_COOLDOWN_MINUTES=120
ALERT_DASHBOARD_URL=http://localhost:3000/alerts
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_RATE_LIMIT_PER_MINUTE=20
TELEGRAM_AUDIT_RETENTION_DAYS=90

# Observability (localhost-bound dashboards and optional routing)
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_unique_grafana_password
MONGO_MONITOR_URI=mongodb://mongo:27017
MONITORING_INFRA_CHAT_ID=
MONITORING_API_CHAT_ID=
MONITORING_STREAMING_CHAT_ID=
MONITORING_DATA_CHAT_ID=
MONITORING_DATABASE_CHAT_ID=
MONITORING_BACKUP_CHAT_ID=
MONITORING_SMTP_SMARTHOST=
MONITORING_SMTP_FROM=
MONITORING_SMTP_USERNAME=
MONITORING_SMTP_PASSWORD=
MONITORING_EMAIL_TO=
PAGERDUTY_ROUTING_KEY=
BACKUP_INTERVAL_SECONDS=86400
RESTORE_TEST_INTERVAL_SECONDS=604800

# Bootstrap admin (only used by api/create_admin.py)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_secure_admin_password
